# local：本地 Qwen；dify：Dify Chat/Chatflow 应用
GENERATION_PROVIDER=dify

# Dify Cloud 使用 https://api.dify.ai/v1
# 自部署 Dify 按实际地址填写；容器访问宿主机可使用 host.docker.internal
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=app-your-dify-api-key
DIFY_USER=ai-learning-assistant
DIFY_TIMEOUT_SECONDS=60
DIFY_VERIFY_SSL=true

# Hugging Face 缓存目录（容器内）
HF_HOME=/app/.cache/huggingface
